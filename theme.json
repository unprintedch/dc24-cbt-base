{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "palette": [
                {
                    "name": "Primary",
                    "slug": "primary",
                    "color": "#b21221"
                },
                {
                    "name": "Primary-hover",
                    "slug": "primary-hover",
                    "color": "#FF0000"
                },
                {
                    "name": "Secondary",
                    "slug": "secondary",
                    "color": "#202E4E"
                },
                {
                    "name": "Secondary-hover",
                    "slug": "secondary-hover",
                    "color": "#000000"
                },
                {
                    "name": "Gray dark",
                    "slug": "gray-dark",
                    "color": "#1c1c1c"
                },
                {
                    "name": "Gray text",
                    "slug": "gray-text",
                    "color": "#808080"
                },
                {
                    "name": "Gray warm",
                    "slug": "gray-warm",
                    "color": "#84380e"
                },
                {
                    "name": "Gray medium",
                    "slug": "gray-medium",
                    "color": "#8e8e8e"
                },
                {
                    "name": "Gray light",
                    "slug": "gray-light",
                    "color": "#f4f4f4"
                },
                {
                    "name": "White",
                    "slug": "white",
                    "color": "#ffffff"
                }
            ],
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "gradients": []
        },
        "layout": {
            "contentSize": "900px",
            "wideSize": "1800px"
        },
        "spacing": {
            "customSpacingSize": true,
            "defaultSpacingSize": false,
            "spacingScale": {
                "increment": 1.5,
                "mediumStep": 1.5,
                "operator": "*",
                "steps": 7,
                "unit": "rem"
            },
            "spacingSizes": [
                {
                    "name": "Small",
                    "size": "clamp(1rem, 3vw, 1.5rem)",
                    "slug": "40"
                },
                {
                    "name": "Medium",
                    "size": "clamp(1.5rem, 4vw, 2rem)",
                    "slug": "50"
                },
                {
                    "name": "Large",
                    "size": "clamp(2rem, 5vw, 3rem)",
                    "slug": "60"
                },
                {
                    "name": "Xlarge",
                    "size": "clamp(3rem, 7vw, 4rem)",
                    "slug": "70"
                }
            ],
            "units": [
                "px",
                "em",
                "rem",
                "vh",
                "vw",
                "%"
            ]
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "textDecoration": false
                }
            }
        },
        "typography": {
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small"
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium"
                },
                {
                    "slug": "large",
                    "size": "1.125rem",
                    "name": "Large"
                },
                {
                    "slug": "x-large",
                    "size": "1.25rem",
                    "name": "X Large"
                },
                {
                    "slug": "xx-large",
                    "size": "1.5rem",
                    "name": "XX Large"
                },
                {
                    "slug": "xxx-large",
                    "size": "2rem",
                    "name": "XXX Large"
                }
            ],
            "fontFamilies": [
                {
                    "name": "Display",
                    "slug": "display",
                    "fontFamily": "\"Circular\"",
                    "fontFace": [
                        {
                            "fontFamily": "\"Circular\"",
                            "fontStyle": "normal",
                            "fontWeight": "400",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/circular/lineto-circular-book.woff2",
                                "file:./assets/fonts/circular/lineto-circular-book.woff",
                                "file:./assets/fonts/circular/lineto-circular-book.eot"
                            ]
                        },
                        {
                            "fontFamily": "\"Circular\"",
                            "fontStyle": "normal",
                            "fontWeight": "500",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/circular/lineto-circular-medium.woff2",
                                "file:./assets/fonts/circular/lineto-circular-medium.woff",
                                "file:./assets/fonts/circular/lineto-circular-medium.eot"
                            ]
                        },
                        {
                            "fontFamily": "\"Circular\"",
                            "fontStyle": "normal",
                            "fontWeight": "700",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/circular/lineto-circular-bold.woff2",
                                "file:./assets/fonts/circular/lineto-circular-bold.woff",
                                "file:./assets/fonts/circular/lineto-circular-bold.eot"
                            ]
                        }
                    ]
                }
            ],
            "fontWeights": [
                {
                    "slug": "400",
                    "name": "Regular",
                    "weight": "400"
                },
                {
                    "slug": "500",
                    "name": "Medium",
                    "weight": "500"
                },
                {
                    "slug": "600",
                    "name": "Semi Bold",
                    "weight": "600"
                },
                {
                    "slug": "700",
                    "name": "Bold",
                    "weight": "700"
                }
            ],
            "lineHeights": [
                {
                    "slug": "tight",
                    "name": "Tight",
                    "size": "1.2"
                },
                {
                    "slug": "normal",
                    "name": "Normal",
                    "size": "1.6"
                },
                {
                    "slug": "relaxed",
                    "name": "Relaxed",
                    "size": "1.8"
                }
            ]
        },
        "useRootPaddingAwareAlignments": true
    },
    "styles": {
        "spacing": {
            "padding": {
                "left": "var:preset|spacing|50",
                "right": "var:preset|spacing|50"
            },
            "margin": {
                "top": "0",
                "bottom": "var:preset|spacing|50"
            }
        },
        "typography": {
            "fontFamily": "var:preset|font-family|display",
            "fontWeight": "var:preset|font-weight|400",
            "lineHeight": "var:preset|line-height|normal"
        },
        "elements": {
            "h1": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "4rem",
                    "fontWeight": "700",
                    "lineHeight": "1.2"
                },
                "spacing": {
                    "margin": {
                        "top": "1rem",
                        "bottom": "1rem"
                    }
                }
            },
            "h2": {
                "color": {
                    "text": "var(--wp--preset--color--gray-dark)"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "2rem",
                    "fontWeight": "600",
                    "lineHeight": "1.2"
                },
                "spacing": {
                    "margin": {
                        "top": "1rem",
                        "bottom": "1rem"
                    }
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "1.5rem",
                    "fontWeight": "600",
                    "lineHeight": "1.2"
                },
                "spacing": {
                    "margin": {
                        "top": "1rem",
                        "bottom": "1rem"
                    }
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "1.25rem",
                    "fontWeight": "500",
                    "lineHeight": "1.2"
                },
                "spacing": {
                    "margin": {
                        "top": "1rem",
                        "bottom": "1rem"
                    }
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "1.125rem",
                    "fontWeight": "500",
                    "lineHeight": "1.2"
                },
                "spacing": {
                    "margin": {
                        "top": "1rem",
                        "bottom": "1rem"
                    }
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "var:preset|font-family|display",
                    "fontSize": "1rem",
                    "fontWeight": "500",
                    "lineHeight": "1.2"
                },
                "spacing": {
                    "margin": {
                        "top": "1rem",
                        "bottom": "1rem"
                    }
                }
            },
            "p": {
                "typography": {
                    "fontSize": "1.125rem"
                },
                "spacing": {
                    "margin": {
                        "top": "0.5rem",
                        "bottom": "0.5rem"
                    }
                }
            }
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header"
        },
        {
            "area": "footer",
            "name": "footer"
        }
    ]
}